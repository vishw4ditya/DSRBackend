# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/crm_platform

# Secret used to sign JWT tokens - change this in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port for the API server
PORT=5000

# CORS - frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# First Super Admin seed credentials (used only by `npm run seed`)
SEED_SUPERADMIN_NAME=System Administrator
SEED_SUPERADMIN_PHONE=9999999999
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=Admin@12345
